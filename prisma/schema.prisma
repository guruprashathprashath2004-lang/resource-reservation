generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("teams")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(MEMBER)
  teamId       String?
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  reservations Reservation[]
  auditLogs    AuditLog[]
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@index([teamId])
  @@map("users")
}

model ResourceCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  resources Resource[]

  @@map("resource_categories")
}

model Resource {
  id                 String           @id @default(cuid())
  name               String
  description        String?
  location           String?
  capacity           Int              @default(1)
  isActive           Boolean          @default(true)
  openHour           Int              @default(8)
  closeHour          Int              @default(18)
  maxDurationMinutes Int              @default(240)
  categoryId         String
  category           ResourceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reservations       Reservation[]
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  @@index([categoryId])
  @@map("resources")
}

model Reservation {
  id         String            @id @default(cuid())
  title      String
  notes      String?
  startTime  DateTime          @db.Timestamptz(3)
  endTime    DateTime          @db.Timestamptz(3)
  status     ReservationStatus @default(PENDING)
  resourceId String
  resource   Resource          @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)

  @@index([resourceId, startTime, endTime])
  @@index([userId])
  @@index([status])
  @@map("reservations")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  details   Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}